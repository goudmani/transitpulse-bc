.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- data / local scratch ---
weather.parquet
*.parquet
tests/fixtures/offline_sample.json
