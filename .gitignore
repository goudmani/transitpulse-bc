TRANSITPULSE-MASTER-GUIDE.md

# --- credentials: never commit ---
.env
.env.*
*.pem
.aws/

# --- terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# tfvars may hold emails/account ids; envs/ is intentionally tracked
*.auto.tfvars
terraform.tfvars

# --- build artifacts ---
build/
infra/modules/*/build/
dist/
*.zip

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- data / local scratch ---
# Raw and intermediate data stays out of git -- but the small derived facts do
# not. agent/docs_updater.py reads data/processed/evaluation.json to render the
# README's model row, and scripts/plot_profile.py reads the two CSVs to draw the
# charts. Ignoring them means the nightly docs run silently reverts the README to
# "pending" and the figures cannot be reproduced from a fresh clone.
data/*
!data/processed/
data/processed/*
!data/processed/*.csv
!data/processed/evaluation.json
weather.parquet
*.parquet
*.csv
tests/fixtures/offline_sample.json
docs/interview-brief.html
docs/portfolio-brief.md
docs/agent-interview.html

# --- os / editor ---
.DS_Store
.ipynb_checkpoints/
